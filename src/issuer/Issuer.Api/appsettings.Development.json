{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Persistence": {
    "Provider": "InMemory"
  },
  "Issuer": {
    "Blockchain": {
      "Enabled": false
    },
    "ContentAnchor": {
      "Enabled": true,
      "VerifyEnabled": true,
      "GatewayBase": "https://ipfs.io/ipfs",
      "IpfsTimeoutSeconds": 30
    },
    "Auth": {
      "RequireAuthentication": false
    }
  }
}
