{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Persistence": {
    "Provider": "InMemory"
  },
  "Auth": {
    "JwtIssuer": "sovereignid-auth",
    "JwtAudience": "sovereignid-clients",
    "JwtSigningKey": "development-only-signing-key-32-bytes!"
  },
  "Reports": {
    "SnapshotJobHourUtc": 1
  }
}
