  "components": {
    "schemas": {
      "CredentialsPerStudentReportResponse": {
        "required": [
          "asOf",
          "totalStudents",
          "totalCredentials",
          "averageCredentialsPerStudent"
        ],
        "type": "object",
        "properties": {
          "asOf": {
            "type": "string"
          },
          "totalStudents": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "totalCredentials": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "averageCredentialsPerStudent": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "PlatformCredentialsByInstitutionResponse": {
        "required": [
          "period",
          "source",
          "items"
        ],
        "type": "object",
        "properties": {
          "period": {
            "$ref": "#/components/schemas/ReportPeriodResponse"
          },
          "source": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlatformRankingItemResponse"
            }
          }
        }
      },
      "PlatformRankingItemResponse": {
        "required": [
          "institutionId",
          "displayName",
          "total"
        ],
        "type": "object",
        "properties": {
          "institutionId": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "PlatformStudentsByInstitutionResponse": {
        "required": [
          "asOf",
          "items"
        ],
        "type": "object",
        "properties": {
          "asOf": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlatformStudentsItemResponse"
            }
          }
        }
      },
      "PlatformStudentsItemResponse": {
        "required": [
          "institutionId",
          "displayName",
          "totalStudents"
        ],
        "type": "object",
        "properties": {
          "institutionId": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "totalStudents": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ReportPeriodResponse": {
        "required": [
          "from",
          "to"
        ],
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        }
      },
      "TimeSeriesPointResponse": {
        "required": [
          "date",
          "value"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "value": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "TimeSeriesReportResponse": {
        "required": [
          "period",
          "source",
          "total",
          "series"
        ],
        "type": "object",
        "properties": {
          "period": {
            "$ref": "#/components/schemas/ReportPeriodResponse"
          },
          "source": {
            "type": "string"
          },
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "series": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TimeSeriesPointResponse"
            }
          }
        }
      },
      "VerificationOutcomePointResponse": {
        "required": [
          "date",
          "valid",
          "invalid"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "valid": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "invalid": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "VerificationOutcomesReportResponse": {
        "required": [
          "period",
          "source",
          "validTotal",
          "invalidTotal",
          "series"
        ],
        "type": "object",
        "properties": {
          "period": {
            "$ref": "#/components/schemas/ReportPeriodResponse"
          },
          "source": {
            "type": "string"
          },
          "validTotal": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "invalidTotal": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "series": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VerificationOutcomePointResponse"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Health"
    },
    {
      "name": "InstitutionReports"
    },
    {
      "name": "PlatformReports"
    }
  ]
}
